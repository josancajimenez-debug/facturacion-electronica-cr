# Backend de datos:
#   local    -> todo en el navegador (localStorage); no requiere servicios externos.
#   supabase -> Supabase Auth + PostgreSQL (RLS) + Realtime + función Edge "api".
VITE_BACKEND=local

# Ambiente tributario. Este proyecto solo admite "simulacion": no envía comprobantes reales.
VITE_APP_AMBIENTE=simulacion

# Solo para VITE_BACKEND=supabase (Project Settings > API). La llave "anon"/"publishable" es pública;
# NUNCA coloque aquí la llave service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
