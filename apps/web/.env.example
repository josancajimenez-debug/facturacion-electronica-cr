# Backend de datos:
#   local    -> todo en el navegador (localStorage); no requiere Firebase. Ideal para practicar.
#   firebase -> Firebase Auth + Firestore + Cloud Functions (emuladores o proyecto real).
VITE_BACKEND=local

# Ambiente tributario. Este proyecto solo admite "simulacion": no envía comprobantes reales.
VITE_APP_AMBIENTE=simulacion

# Solo para VITE_BACKEND=firebase
VITE_USAR_EMULADORES=true
VITE_FIREBASE_PROJECT_ID=demo-fe-cr
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-fe-cr.firebaseapp.com
VITE_FIREBASE_APP_ID=
