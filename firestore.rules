rules_version = '2';

// Reglas de seguridad del simulador de comprobantes electrónicos.
// - Cada emisor (obligado tributario) solo es visible para sus miembros.
// - Comprobantes, recibidos, contadores y bitácora SOLO los escriben las Cloud Functions
//   (Admin SDK), lo que protege la integridad de consecutivos, claves y trazabilidad.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esMiembro(emisorId) {
      return autenticado()
        && request.auth.uid in get(/databases/$(database)/documents/emisores/$(emisorId)).data.miembros;
    }

    function identificacionValida(id) {
      return id.tipo in ['01', '02', '03', '04', '05', '06']
        && id.numero is string && id.numero.size() >= 1 && id.numero.size() <= 20;
    }

    match /usuarios/{uid} {
      allow read, write: if autenticado() && request.auth.uid == uid;
    }

    match /parametros/{doc} {
      allow read: if autenticado();
      allow write: if false;
    }

    match /emisores/{emisorId} {
      allow get: if esMiembro(emisorId);
      // Consultas (where miembros array-contains uid): se evalúan sobre el propio documento.
      allow list: if autenticado() && request.auth.uid in resource.data.miembros;
      allow create: if autenticado()
        && request.resource.data.propietarioUid == request.auth.uid
        && request.resource.data.miembros == [request.auth.uid]
        && identificacionValida(request.resource.data.identificacion)
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 5;
      // No se permite cambiar la membresía ni el propietario desde el cliente.
      allow update: if esMiembro(emisorId)
        && request.resource.data.miembros == resource.data.miembros
        && request.resource.data.propietarioUid == resource.data.propietarioUid
        && identificacionValida(request.resource.data.identificacion);
      allow delete: if false;

      match /receptores/{id} {
        allow read, delete: if esMiembro(emisorId);
        allow create, update: if esMiembro(emisorId)
          && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 3
          && (!('identificacion' in request.resource.data) || identificacionValida(request.resource.data.identificacion));
      }

      match /productos/{id} {
        allow read, delete: if esMiembro(emisorId);
        allow create, update: if esMiembro(emisorId)
          && request.resource.data.codigoCabys.matches('^[0-9]{13}$')
          && request.resource.data.precioUnitario is number && request.resource.data.precioUnitario > 0
          && request.resource.data.codigoTarifaIva in ['01','02','03','04','05','06','07','08','09','10','11'];
      }

      match /comprobantes/{clave} {
        allow read: if esMiembro(emisorId);
        allow write: if false;
      }

      match /recibidos/{clave} {
        allow read: if esMiembro(emisorId);
        allow write: if false;
      }

      match /bitacora/{id} {
        allow read: if esMiembro(emisorId);
        allow write: if false;
      }

      match /contadores/{id} {
        allow read, write: if false;
      }
    }
  }
}
